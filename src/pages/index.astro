---
import cartell from '../assets/cartells/cartell-garrinada-2026.jpg'
import CartellImage from '../components/CartellImage.astro'
import Facebook from '../components/icon/Facebook.astro'
import Instagram from '../components/icon/Instagram.astro'
import MainLayout from '../layouts/MainLayout.astro'

interface ArtistImage {
  src: string
  alt: string
  caption: string
  width: number
  height: number
}

interface ProgramItem {
  title: string
  time: string
  place?: string
  paragraphs: readonly string[]
  facts?: readonly string[]
  lineup?: readonly string[]
  artists?: readonly ArtistImage[]
  featured?: boolean
}

interface FestivalDay {
  id: string
  weekday: string
  date: string
  dateTime: string
  tone: 'paper' | 'forest' | 'blue'
  items: readonly ProgramItem[]
}

const days: readonly FestivalDay[] = [
  {
    id: 'dia-4',
    weekday: 'Dimarts',
    date: '04',
    dateTime: '2026-08-04',
    tone: 'paper',
    items: [
      {
        title: 'Torneig 3x3 de bàsquet',
        time: 'A partir de les 16 h',
        place: 'Pavelló Municipal Raül Paloma',
        paragraphs: [
          'S’organitzaran les categories en funció dels participants. Se n’informarà a través de les xarxes socials i per correu electrònic. Cal inscripció prèvia.',
        ],
      },
      {
        title: 'Garridub',
        time: 'Portes a les 17.45 h · Música a partir de les 18 h',
        place: 'Espai La Porqueta',
        lineup: [
          'Sagittarius Hi Fi',
          'Vibronics',
          'La Santa Sound Live Show',
          'Jahrrinada Collective',
        ],
        paragraphs: [
          'Sagittarius Hi Fi sonoritzarà una nova tarda de cultura sound system. La Santa Sound Live Show actuarà amb les col·laboracions de Naycostero, Sofita i Paubeats, acompanyats de la Jahrrinada Collective.',
          'Tot seguit arribarà Vibronics, directament des de Leeds (Regne Unit), per completar una sessió de dub que farà vibrar La Porqueta.',
        ],
      },
      {
        title: 'Concerts',
        time: 'Després dels focs · De 23.10 a 5 h',
        place: 'Escola Argentona',
        lineup: [
          'Hip Horns Brass Collective',
          'Ruïnosa y las Strippers de Rahola',
          'Baya Baye',
          'Gea',
        ],
        paragraphs: [
          'La primera nit arrenca amb Hip Horns Brass Collective, una brass band explosiva amb músics argentonins que barreja el so de Nova Orleans amb hip-hop, funk i groove.',
          'Tot seguit, Ruïnosa y las Strippers de Rahola hi portaran el seu punk turboqueer. Baya Baye, maresmenc i pare del macarrisme català, posarà Argentona del revés, i Gea la tancarà combinant una sessió de DJ amb veu en directe.',
        ],
        featured: true,
      },
    ],
  },
  {
    id: 'dia-5',
    weekday: 'Dimecres',
    date: '05',
    dateTime: '2026-08-05',
    tone: 'forest',
    items: [
      {
        title: 'Tarda infantil',
        time: 'A partir de les 18 h',
        place: 'Escola Argentona',
        paragraphs: [
          'Una tarda d’activitats perquè en gaudeixin petits i grans, amb el concert de Sardines en Llauna, un taller de grafiti i un taller d’estampació de samarretes.',
          'Per participar en el taller d’estampació, porteu una samarreta de casa; pot ser de qualsevol color. El concert infantil està organitzat per l’Ajuntament d’Argentona.',
        ],
      },
      {
        title: 'Tarda Popular',
        time: 'A partir de les 18.45 h',
        place: 'Escola Argentona',
        paragraphs: [
          'La Porqueta acull la Tarda Popular per cinquena vegada. Recuperem activitats mítiques com l’aixecada de caipis i el concurs de crits, i hi afegim una activitat musical completament nova.',
          'També posarem a prova la memòria del públic més veterà de la Garri. Hi haurà premis nous, grossos i sucosos per a les persones més atrevides i entregades, gentilesa de comerços del poble.',
        ],
      },
      {
        title: 'Sopar popular',
        time: 'A partir de les 20.30 h',
        place: 'Escola Argentona',
        paragraphs: [
          'El porc a l’ast de La Garrinada és una tradició que només es pot degustar una vegada l’any: es marina durant 12 hores i es cuina durant 12 hores més.',
          'El sopar inclou porc a l’ast, patates al caliu, amanida, pa, aigua, vi i fruita. Els tiquets són limitats i s’acostumen a acabar aviat.',
        ],
        facts: [
          'Preu: 15 €.',
          'Venda anticipada a Ca l’Arenas i, a partir del 4 d’agost, a la barra de La Garrinada.',
          'Porteu els plats i els coberts de casa per generar menys residus.',
          'Les furgoteques ofereixen opcions vegetarianes, veganes i sense gluten.',
        ],
      },
      {
        title: 'Concerts',
        time: 'De 23 a 5 h',
        place: 'Escola Argentona',
        lineup: ['La Ludwig Band', 'Skarra Mucci', 'Ignorantes', 'DJ Trapella'],
        paragraphs: [
          'La Ludwig Band obrirà la nit amb el seu pop d’autor irònic, vital i ple d’històries quotidianes convertides en himnes generacionals. Tot seguit arribarà Skarra Mucci, icona del reggae jamaicà, amb un directe carregat de dancehall, carisma i energia.',
          'Ignorantes faran esclatar la festa amb el seu directe de ritme i actitud. Per acabar, DJ Trapella tornarà a posar la pista del revés amb els hits d’avui i de sempre.',
        ],
        artists: [
          {
            src: '/img/2024-garrinada/La-Ludwig-Band.jpg',
            alt: 'La Ludwig Band',
            caption: 'La Ludwig Band',
            width: 700,
            height: 977,
          },
          {
            src: '/img/2025-garrinada/trapella.jpg',
            alt: 'DJ Trapella',
            caption: 'DJ Trapella',
            width: 1200,
            height: 1800,
          },
        ],
        featured: true,
      },
    ],
  },
  {
    id: 'dia-6',
    weekday: 'Dijous',
    date: '06',
    dateTime: '2026-08-06',
    tone: 'blue',
    items: [
      {
        title: 'Gran Caipirinyada Popular',
        time: 'De 17.30 a 23 h',
        place: 'Escola Argentona',
        lineup: ['Les Que Faltaband', 'DJ Domingo el Gran'],
        paragraphs: [
          'Torna una de les tardes més esperades pel públic garrí, amb una barra XL i una nova aposta musical. Les Que Faltaband, grup de versions de referència a Catalunya, ompliran l’escenari de hits en femení.',
          'Després arribarà l’esperat retorn del resident garrí DJ Domingo el Gran, que tancarà una tarda ben argentonina.',
        ],
        facts: [
          'Obertura de portes i venda de tiquets a les 17.30 h.',
          'Horari de servei de caipirinyes: de 18.30 a 20.30 h.',
          'Preu: 16 €; inclou set caipirinyes i una samarreta de regal.',
          'Venda de tiquets fins a exhaurir existències; samarretes subjectes a disponibilitat.',
        ],
      },
      {
        title: 'Concerts',
        time: 'De 23 a 5.30 h',
        place: 'Escola Argentona',
        lineup: [
          'Maria Jaume',
          'Serko',
          'Dan Peralbo i el Comboi',
          'Anna Gisbert',
        ],
        paragraphs: [
          'Maria Jaume obrirà l’última nit en el moment perfecte per presentar Sant Domingo Forever, el seu nou disc, inspirat en les festes patronals del seu poble de Mallorca.',
          'Tot seguit, Serko fusionarà rumba, flamenc, pop i música urbana amb una lírica personal i propera. Dan Peralbo i el Comboi presentaran Quin goig, una celebració de rock festiu en català, i Anna Gisbert posarà el punt final a una Garrinada inoblidable amb una selecció dels millors hits.',
        ],
        featured: true,
      },
    ],
  },
]
---

<MainLayout
  title="Garrinada 2026 - Argentona - 4, 5 i 6 d’agost - Festa Major de Sant Domènec"
  description="Programa de La Garrinada 2026: activitats, concerts i informació pràctica per als dies 4, 5 i 6 d’agost a Argentona."
  themeColor="#055428"
>
  <a class="skip-link" href="#programa">Salta al programa</a>

  <main>
    <section class="hero" aria-labelledby="titol-garrinada">
      <div class="hero__inner">
        <div class="hero__copy">
          <p class="eyebrow">Festa major autogestionada d’Argentona</p>
          <h1 id="titol-garrinada">
            <span>La Garrinada</span>
            <span class="hero__year">2026</span>
          </h1>
          <p class="hero__festival">Festa Major de Sant Domènec</p>
          <p class="hero__lead">
            Tres dies de cultura popular, música i festa.
          </p>
          <ul class="hero__facts" aria-label="Dades principals">
            <li>
              <span>Quan</span>
              <strong>4, 5 i 6 d’agost</strong>
            </li>
            <li>
              <span>On</span>
              <strong>Escola Argentona</strong>
            </li>
            <li>
              <span>Accés</span>
              <strong>Entrada gratuïta</strong>
            </li>
          </ul>
        </div>

        <div class="poster-frame">
          <CartellImage
            cartell={cartell}
            alt="Cartell de La Garrinada 2026"
            id="img-cartell"
            quality={80}
            widths={[480, 640, 680, 800, 1200, 1440]}
          />
        </div>
      </div>
    </section>

    <nav class="day-nav" aria-label="Navegació pel programa">
      <div class="day-nav__inner">
        <span class="day-nav__label">Programa</span>
        {
          days.map((day) => (
            <a href={`#${day.id}`}>
              <span>{day.weekday}</span>
              <strong>{day.date}</strong>
            </a>
          ))
        }
        <a href="#informacio">
          <span>Info</span>
          <strong>+</strong>
        </a>
      </div>
    </nav>

    <div id="programa">
      {
        days.map((day) => (
          <section
            id={day.id}
            class:list={['program-day', `program-day--${day.tone}`]}
            aria-labelledby={`${day.id}-title`}
          >
            <div class="content-wrap">
              <header class="day-heading">
                <h2 id={`${day.id}-title`}>
                  <time datetime={day.dateTime}>
                    <span class="day-heading__weekday">{day.weekday}</span>
                    <span class="day-heading__date">{day.date}</span>
                    <span class="day-heading__month">Agost</span>
                  </time>
                </h2>
              </header>

              <div class="events-grid">
                {day.items.map((item, itemIndex) => (
                  <article
                    class:list={[
                      'event-card',
                      { 'event-card--featured': item.featured },
                    ]}
                  >
                    <header class="event-card__header">
                      <span class="event-card__number" aria-hidden="true">
                        {String(itemIndex + 1).padStart(2, '0')}
                      </span>
                      <div>
                        <h3>{item.title}</h3>
                        <p class="event-meta">
                          <span>{item.time}</span>
                          {item.place && <span>{item.place}</span>}
                        </p>
                      </div>
                    </header>

                    {item.lineup && (
                      <ul
                        class="lineup"
                        aria-label={`Cartell de ${item.title}`}
                      >
                        {item.lineup.map((artist) => (
                          <li>{artist}</li>
                        ))}
                      </ul>
                    )}

                    <div class="event-copy">
                      {item.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>

                    {item.artists && (
                      <div class="artist-grid">
                        {item.artists.map((artist) => (
                          <figure class="artist-card">
                            <img
                              src={artist.src}
                              alt={artist.alt}
                              width={artist.width}
                              height={artist.height}
                              loading="lazy"
                              decoding="async"
                            />
                            <figcaption>{artist.caption}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}

                    {item.facts && (
                      <ul class="details-list">
                        {item.facts.map((fact) => (
                          <li>{fact}</li>
                        ))}
                      </ul>
                    )}
                  </article>
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </div>

    <section class="general-info" id="informacio" aria-labelledby="info-title">
      <div class="content-wrap">
        <header class="general-info__heading">
          <p>Abans de venir</p>
          <h2 id="info-title">Informació general</h2>
        </header>

        <div class="info-grid">
          <article class="info-card info-card--yellow">
            <p class="info-card__index">01</p>
            <h3>Com arribar</h3>
            <p>
              La Garrinada se celebra a l’<a
                href="https://www.google.com/maps/place/Escola+Argentona/@41.5503881,2.4055149,17.94z/data=!3m1!5s0x12a4b5b95c6990f9:0x1cbc6f4bad196099!4m14!1m7!3m6!1s0x12a4b5bbf81685ab:0xae5cfbc04cb2e412!2sRtda.+del+Pi+Gros!8m2!3d41.5510591!4d2.4066127!16s%2Fg%2F1tdjls3_!3m5!1s0x12a4b5b95cec114d:0x39707c5c6f4860f!8m2!3d41.5502433!4d2.4054737!16s%2Fg%2F12qh936l1?entry=ttu&g_ep=EgoyMDI1MDcyNy4wIKXMDSoASAFQAw%3D%3D"
                target="_blank"
                rel="noopener noreferrer"><strong>Escola Argentona</strong></a
              >, situada a l’avinguda dels Països Catalans, s/n.
            </p>
          </article>

          <article class="info-card">
            <p class="info-card__index">02</p>
            <h3>Furgoteques</h3>
            <p>
              Hi haurà servei de furgoteques durant tota la nit, amb opcions
              vegetarianes, veganes i sense gluten.
            </p>
          </article>

          <article class="info-card info-card--wide">
            <p class="info-card__index">03</p>
            <h3>Servei especial de bus nocturn</h3>
            <p>
              Les nits del 3 al 6 d’agost hi haurà dues línies especials amb
              parada a la rotonda del Pi Gros. Una connectarà el nucli urbà amb
              El Cros i Mataró —estació de Rodalies, TecnoCampus i plaça de
              l’Alcalde Serra i Xifra— i l’altra amb les urbanitzacions —Les
              Ginesteres, Can Cabot, Can Raimí, Can Ribosa i Madà.
            </p>
            <p>
              El servei funcionarà des de les 22 h fins a les 6 o les 7 h del
              matí, segons el dia.
            </p>
            <a
              class="text-link"
              href="https://argentona.cat/document.php?id=63722"
              >Consulta els horaris del bus especial</a
            >
          </article>

          <article class="info-card">
            <p class="info-card__index">04</p>
            <h3>Bus nocturn N80</h3>
            <p>
              Per tornar al Maresme sud i a Barcelona de nit podeu utilitzar el
              bus nocturn N80.
            </p>
            <a
              class="text-link"
              href="https://www.moventis.es/ca/linies-horaris/linia-autobus-n-80-barcelona-mataro-nocturna"
              >Consulta la línia N80</a
            >
          </article>

          <article class="info-card">
            <p class="info-card__index">05</p>
            <h3>Altres opcions</h3>
            <p>
              Consulteu la resta de línies i alternatives de transport als webs
              de l’<a href="https://argentona.cat/transport"
                >Ajuntament d’Argentona</a
              > i de <a href="https://www.sagales.com/">Sagalés</a>.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>Segueix La Garrinada</p>
    <div class="social-links">
      <Facebook />
      <Instagram />
    </div>
    <p class="site-footer__tagline">La festa més porca del Maresme</p>
  </footer>
</MainLayout>

<script>
  const dayNav = document.querySelector<HTMLElement>('.day-nav')
  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.day-nav a[href^="#"]')
  )
  const observedSections = sectionLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null)

  const updateCurrentSection = () => {
    const marker =
      (dayNav?.offsetHeight ?? 0) + Math.min(window.innerHeight * 0.22, 180)
    const currentSection = observedSections.find((section) => {
      const { top, bottom } = section.getBoundingClientRect()
      return top <= marker && bottom > marker
    })

    sectionLinks.forEach((link) => {
      if (currentSection && link.hash === `#${currentSection.id}`) {
        link.setAttribute('aria-current', 'location')
      } else {
        link.removeAttribute('aria-current')
      }
    })
  }

  let scrollFrame: number | undefined

  const scheduleCurrentSectionUpdate = () => {
    if (scrollFrame !== undefined) return

    scrollFrame = window.requestAnimationFrame(() => {
      scrollFrame = undefined
      updateCurrentSection()
    })
  }

  window.addEventListener('scroll', scheduleCurrentSectionUpdate, {
    passive: true,
  })
  window.addEventListener('resize', scheduleCurrentSectionUpdate)
  window.addEventListener('hashchange', scheduleCurrentSectionUpdate)
  updateCurrentSection()
</script>

<style is:global>
  :root {
    --paper: #e4ebf1;
    --paper-light: #f7fafb;
    --forest: #055428;
    --forest-dark: #043c20;
    --yellow: #f2d31b;
    --blue: #94b0d3;
    --mint: #bed4af;
    --blush: #efddd5;
    --charcoal: #262a29;
    --ink: #173627;
    --content-width: 1180px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
    color: var(--ink);
    font-family:
      'Trebuchet MS', 'Avenir Next', 'Helvetica Neue', Arial, sans-serif;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }

  a:hover {
    text-decoration-thickness: 0.2em;
  }

  a:focus-visible {
    outline: 4px solid var(--yellow);
    outline-offset: 4px;
  }

  img {
    max-width: 100%;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.8rem 1rem;
    color: var(--forest-dark);
    background: var(--yellow);
    font-weight: 800;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .content-wrap {
    width: min(100% - 2rem, var(--content-width));
    margin-inline: auto;
  }

  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(2rem, 6vw, 6.5rem) 0 clamp(4rem, 8vw, 8rem);
    overflow: hidden;
    color: var(--paper);
    background:
      radial-gradient(circle at 91% 78%, var(--yellow) 0 5px, transparent 6px),
      radial-gradient(circle at 94% 74%, var(--yellow) 0 5px, transparent 6px),
      var(--forest);
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: -9rem;
    bottom: -12rem;
    width: 32rem;
    aspect-ratio: 1;
    border: 6rem solid color-mix(in srgb, var(--mint) 38%, transparent);
    border-radius: 50%;
  }

  .hero__inner {
    width: min(100% - 2rem, var(--content-width));
    margin-inline: auto;
    display: grid;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .hero__copy {
    min-width: 0;
  }

  .eyebrow,
  .general-info__heading > p {
    margin: 0 0 1rem;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .eyebrow {
    max-width: 29rem;
    color: var(--yellow);
  }

  .hero h1 {
    margin: 0;
    font-family:
      'Arial Black', 'Avenir Next Condensed', Impact, 'Helvetica Neue',
      sans-serif;
    font-size: clamp(3.7rem, 7vw, 4.9rem);
    font-weight: 950;
    letter-spacing: -0.075em;
    line-height: 0.78;
    text-transform: uppercase;
  }

  .hero h1 > span {
    display: block;
  }

  .hero h1 .hero__year {
    margin-top: 0.12em;
    color: var(--yellow);
    font-size: 0.72em;
    letter-spacing: 0.08em;
  }

  .hero__festival {
    margin: 1.35rem 0 0;
    color: var(--mint);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    font-weight: 900;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hero__lead {
    max-width: 28rem;
    margin: 1rem 0 2rem;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .hero__facts {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
    list-style: none;
  }

  .hero__facts li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
  }

  .hero__facts span {
    color: var(--mint);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__facts strong {
    text-align: right;
  }

  .poster-frame {
    position: relative;
    width: min(100%, 700px);
    margin-inline: auto;
    padding: clamp(0.45rem, 1vw, 0.75rem);
    background: var(--yellow);
    box-shadow: clamp(0.75rem, 2vw, 1.5rem) clamp(0.75rem, 2vw, 1.5rem) 0
      var(--blue);
  }

  .poster-frame::before,
  .poster-frame::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: clamp(3rem, 9vw, 6rem);
    aspect-ratio: 1.7;
    border: 0.28rem solid var(--yellow);
    border-radius: 100% 0 100% 0;
  }

  .poster-frame::before {
    top: -1.5rem;
    left: -1.5rem;
    rotate: -20deg;
  }

  .poster-frame::after {
    right: -1.5rem;
    bottom: -1.5rem;
    rotate: 160deg;
  }

  #img-cartell {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    background: var(--paper);
  }

  .day-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    color: var(--forest);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom: 2px solid var(--forest);
    backdrop-filter: blur(12px);
