<style>
  :root {
    --max-width: 800px;
    --pink: hsla(328, 100%, 54%, 1);
    --yellow-orange: hsla(0, 97%, 71%, 1);
    --gradient: linear-gradient(
      225deg,
      var(--pink) 10%,
      var(--yellow-orange) 90%
    );
  }
  img {
    width: 100%;
    height: auto;
  }
  .img-square {
    aspect-ratio: 1;
  }
  h1 {
    font-size: 3rem;
    font-weight: 800;
    margin: 10px 20px;
    text-align: center;
  }
  .section-main-info {
    margin: auto;
    padding: 1.2rem;
    max-width: var(--max-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .section-main-info h2 {
    margin-top: 10px;
  }
  .section-main-info p {
    margin: 8px 0;
  }
  #img-cartell {
    aspect-ratio: 1600 / 2232;
    margin: 50px 0 0;
  }

  .section-with-background {
    width: 100%;
    padding: 2rem 0 5rem;
    margin-top: 3rem;
    clip-path: polygon(
      0 0,
      100% calc(20px + 100vw * 0.02),
      100% 100%,
      0 calc(100% - 100vw * 0.02 - 20px)
    );
    background: var(--gradient);
    color: var(--black);
  }
  .section-no-background {
    padding-top: 5px;
  }
  .container-max-width {
    margin: auto;
    max-width: var(--max-width);
    padding: 0 1.2rem;
  }
  .responsive-2-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }
  @media all and (min-width: 520px) {
    .responsive-2-columns {
      grid-template-columns: 1fr 1fr;
    }
  }
  .dj-hochi {
    margin-bottom: 12px;
  }
  @media all and (min-width: 520px) {
    .dj-hochi {
      order: 1;
      margin-bottom: 0px;
    }
    .p-dia5-nit-perfecta {
      order: 2;
      margin-bottom: 0;
    }
  }
  .bus-link {
    color: var(--pink-mid-gradient);
    display: inline-block;
    padding: 7px 0;
  }

  footer {
    clip-path: polygon(0 0, 100% calc(20px + 100vw * 0.02), 100% 100%, 0 100%);
    background: var(--gradient);
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 3rem;
    padding-top: 70px;
    padding-bottom: 45px;
  }
  footer .social-icon {
    margin: 0 20px;
    transition: transform 0.1s ease-in-out;
  }
  footer .social-icon:hover {
    transform: scale(1.25);
  }
  .social-icon {
    width: 38px;
  }
  @media all and (min-width: 480px) {
    .social-icon {
      width: 42px;
    }
  }
</style>
