---
interface Props {
  title: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Garrinada - Argentona - 4, 5 i 6 d'agost - Festa Major de Sant Domènec"
    />
    <!-- TODO check favicon:
		https://realfavicongenerator.net/favicon_checker?protocol=http&site=www.garrinada.cat
		-->
    <link rel="icon" type="image/png" href="/favicon-garrinada-196.png" />
    <link
      rel="apple-touch-icon"
      sizes="196x196"
      href="/favicon-garrinada-196.png"
    />
    <link rel="apple-touch-startup-image" href="/porc.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
