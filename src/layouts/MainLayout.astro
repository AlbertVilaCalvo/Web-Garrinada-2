---
interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={title} />
    <link rel="icon" type="image/png" href="/favicon-garrinada-196.png" />
    <link
      rel="apple-touch-icon"
      sizes="196x196"
      href="/favicon-garrinada-196.png"
    />
    <link rel="apple-touch-startup-image" href="/porc.png" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
