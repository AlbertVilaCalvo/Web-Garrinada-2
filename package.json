{
  "name": "garrinada-web-2",
  "type": "module",
  "version": "1.0.0",
  "description": "Web Garrinada Argentona v2 (Astro) - www.garrinada.cat",
  "scripts": {
    "dev": "astro check --watch & astro dev",
    "start": "astro check --watch & astro dev",
    "build": "astro build",
    "preview": "rm -rf dist && npm run build && astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertVilaCalvo/Web-Garrinada.git"
  },
  "author": "Albert Vila Calvo",
  "license": "Propietary",
  "bugs": {
    "url": "https://github.com/AlbertVilaCalvo/Web-Garrinada/issues"
  },
  "homepage": "https://github.com/AlbertVilaCalvo/Web-Garrinada#readme",
  "dependencies": {
    "astro": "5.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "prettier": "3.3.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.5.4"
  }
}
